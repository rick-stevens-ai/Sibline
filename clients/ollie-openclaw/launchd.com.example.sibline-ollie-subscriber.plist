<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.sibline-ollie-subscriber</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/YOUR_USER/.openclaw/workspace/scripts/sibline_subscriber.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/YOUR_USER</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>SIBLINE_AGENT</key>
        <string>ollie</string>
        <key>SIBLINE_PEER</key>
        <string>kukla</string>
        <key>SIBLINE_SERVER</key>
        <string>nats://YOUR_BROKER_IP:4222</string>
        <key>SIBLINE_CREDS_FILE</key>
        <string>/Users/YOUR_USER/.config/sibline/cred</string>
        <key>OPENCLAW_WORKSPACE</key>
        <string>/Users/YOUR_USER/.openclaw/workspace</string>
        <key>SIBLINE_LOG_DIR</key>
        <string>/Users/YOUR_USER/.openclaw/logs</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USER/.openclaw/logs/sibline-subscriber-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USER/.openclaw/logs/sibline-subscriber-stderr.log</string>
    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
