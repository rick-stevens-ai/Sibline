<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sibline NATS broker launchd plist (macOS).
  Install:
    1. Copy nats-server.conf to /etc/sibline/nats-server.conf (or your path) and edit credentials.
    2. Copy this plist to ~/Library/LaunchAgents/com.<user>.sibline-broker.plist
    3. Edit paths below to match your install.
    4. launchctl load -w ~/Library/LaunchAgents/com.<user>.sibline-broker.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.sibline-broker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/nats-server</string>
        <string>-c</string>
        <string>/etc/sibline/nats-server.conf</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/var/log/sibline/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/var/log/sibline/launchd.err</string>
    <key>WorkingDirectory</key>
    <string>/var/lib/sibline</string>
</dict>
</plist>
